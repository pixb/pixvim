{
  "box": {
    "prefix": ["box", "section"],
    "body": [
      "###############",
      "#  ${1:title}  #",
      "###############",
      "$0"
    ],
    "description": "Box section comment (adjust # to match title width)"
  },
  "header": {
    "prefix": ["header", "fileheader"],
    "body": [
      "# ${TM_FILENAME}",
      "# @author pix",
      "# @since ${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE}",
      "# @desc ${1:TODO: description}",
      "",
      "$0"
    ],
    "description": "Conf file header"
  },
  "kv": {
    "prefix": ["kv", "keyvalue"],
    "body": [
      "${1:key} = ${2:value}",
      "$0"
    ],
    "description": "Key = value pair"
  },
  "comment": {
    "prefix": ["c", "comment"],
    "body": [
      "# ${1:TODO: description}",
      "$0"
    ],
    "description": "Comment line"
  }
}
